APP_NAME="Relatórios de Estágio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seu-dominio.example
APP_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo
APP_FALLBACK_LOCALE=pt_BR
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Use mariadb apenas se essa for a conexão configurada para o servidor.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nome_do_banco_no_cpanel
DB_USERNAME=usuario_do_banco_no_cpanel
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
# Não requer um processo de worker permanente; trabalhos rodam na requisição.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
